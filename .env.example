DATABASE_URL=postgres://control_plane:change-me@127.0.0.1:5433/control_plane
CONTROL_PLANE_BIND=127.0.0.1:8090
CONTROL_PLANE_ADMIN_TOKEN=replace-with-at-least-32-random-characters
# Used by Caddy only; not read by the Rust binary. Keep the hash outside the SPA/browser.
CONTROL_PLANE_BASIC_AUTH_HASH=replace-with-caddy-password-hash
CONTROL_PLANE_TELEMETRY_TOKEN=replace-with-a-different-32-char-random-secret
CONTROL_PLANE_TELEMETRY_ACTOR=runtime-reporter
CONTROL_PLANE_RUNTIME_STALE_AFTER_SECONDS=180
# Optional until tenant instance provisioning is enabled. Keep distinct from admin/telemetry.
CONTROL_PLANE_PROVISIONER_TOKEN=replace-with-a-third-32-plus-character-random-secret
CONTROL_PLANE_PROVISIONER_ACTOR=tenant-provisioner
# Default immutable CrowdRelay release used when UI leaves version blank.
CONTROL_PLANE_PROVISIONER_DEFAULT_IMAGE_TAG=sha-0123456789abcdef0123456789abcdef01234567
CONTROL_PLANE_PROVISIONER_API_IMAGE=ghcr.io/crowdrelay/crowdrelay-api
CONTROL_PLANE_PROVISIONER_WORKER_IMAGE=ghcr.io/crowdrelay/crowdrelay-worker
CONTROL_PLANE_PROVISIONER_LEASE_SECONDS=900
CONTROL_PLANE_ADMIN_ACTOR=wojciechbator
CONTROL_PLANE_FRONTEND_DIST=frontend/dist
# Optional: maps the seeded Virya tenant to the real CrowdRelay workspace without changing request hot paths.
CONTROL_PLANE_VIRYA_WORKSPACE_ID=
CONTROL_PLANE_VIRYA_CROWDRELAY_URL=https://signal-api.virya.music
CONTROL_PLANE_VIRYA_SIGNAL_URL=https://signal.virya.music
RUST_LOG=info,tower_http=info

# Narrow tenant AREA management channel. Must be distinct from all other Control Plane secrets.
# Optional until tenant AREA management is enabled on this host.
# CONTROL_PLANE_AREA_MANAGEMENT_MASTER_KEY=replace-with-a-different-long-random-secret
# Narrow health/feature/Autopilot channel. Keep distinct from AREA and all auth tokens.
# CONTROL_PLANE_MANAGEMENT_MASTER_KEY=replace-with-another-distinct-long-random-secret
# The same private target serves AREA and operations. If either master key is configured,
# this URL is mandatory; there is deliberately no application fallback.
# CONTROL_PLANE_VIRYA_MANAGEMENT_URL=http://virya-area-tunnel:18080

# Panel sign-in. Both or neither: the pair seeds and keeps authoritative one
# platform_admin row, so operators can sign in without manual SQL. Changing the
# password here and restarting is how the password is rotated.
# CONTROL_PLANE_BOOTSTRAP_ADMIN_USERNAME=admin
# CONTROL_PLANE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-12-to-128-characters

# Session cookie Secure flag. Leave unset (defaults to true) everywhere the
# panel is served over HTTPS. Only plain-HTTP local development sets false.
# CONTROL_PLANE_COOKIE_SECURE=false

# OAuth redirect allow-list for the agent connect flow, comma separated bare
# origins. SECURITY: when this is unset the redirect_uri is validated against
# the request's own Host header instead — the weaker of the two checks, since
# the caller supplies that header. Set it wherever the panel has a fixed
# public origin. Entries are parsed as origins at boot, so a trailing slash,
# a path or a wrong scheme fails the start rather than silently matching
# nothing.
# CONTROL_PLANE_ALLOWED_REDIRECT_ORIGINS=https://control.virya.music

# LLM agent service. Without it the agent panel is disabled rather than broken.
# CONTROL_PLANE_AGENT_SERVICE_URL=http://agent-service:8095

# Machine-to-machine bearer for n8n automation event ingestion. Distinct from
# admin/telemetry/provisioner so a leaked n8n env cannot touch tenant state.
# CONTROL_PLANE_AUTOMATION_TOKEN=replace-with-another-distinct-32-plus-character-secret
# n8n REST API, used only to retry a failed execution from the panel.
# CONTROL_PLANE_N8N_BASE_URL=https://n8n.virya.music
# CONTROL_PLANE_N8N_API_KEY=replace-with-the-n8n-api-key
# Forwards real-work automation events to Discord. Without it the panel is the
# only surface for them.
# CONTROL_PLANE_DISCORD_AUTOMATION_WEBHOOK_URL=https://discord.com/api/webhooks/...
# HTTPS relay that hands email notifications to the platform mailer. Without
# it, email_relay notifier channels cannot deliver.
# CONTROL_PLANE_NOTIFY_EMAIL_RELAY_URL=https://relay.example.com/send

# GitHub Actions deploy trigger for externally-owned tenants (Virya).
# A PAT or fine-grained token with actions:write on the deploy repo.
# Paired with CONTROL_PLANE_GITHUB_DEPLOY_REPO — both or neither.
# CONTROL_PLANE_GITHUB_DEPLOY_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONTROL_PLANE_GITHUB_DEPLOY_REPO=CrowdRelay/crowdrelay
