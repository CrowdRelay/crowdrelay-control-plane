# Dedicated machine credential. Must differ from admin and telemetry tokens.
CONTROL_PLANE_PROVISIONER_TOKEN=replace-with-a-third-32-plus-character-random-secret
CONTROL_PLANE_TELEMETRY_TOKEN=replace-with-the-control-plane-telemetry-secret
CONTROL_PLANE_PROVISIONER_API_URL=http://127.0.0.1:8090/api/v1
CONTROL_PLANE_PROVISIONER_WORKER_ID=virya-home-tenant-provisioner
# Required for schema-v4 tenant deployments on this agent: eu or us.
# Schema-v3 backlog can still drain on an unclassified legacy agent.
CONTROL_PLANE_PROVISIONER_DATA_REGION=eu
CONTROL_PLANE_TENANT_ROOT=/srv/crowdrelay-tenants
CONTROL_PLANE_TENANT_PORT_START=18100
CONTROL_PLANE_TENANT_PORT_END=18999
CONTROL_PLANE_PROVISIONER_POLL_SECONDS=3
CONTROL_PLANE_PROVISIONER_HEALTH_TIMEOUT_SECONDS=120
CONTROL_PLANE_PROVISIONER_OBSERVER_SECONDS=30
CONTROL_PLANE_PROVISIONER_POSTGRES_IMAGE=postgres:18-alpine
# Shared only by Control Plane API + provisioner; derives a tenant-scoped AREA token.
# Optional until tenant AREA management is enabled on this host.
# CONTROL_PLANE_AREA_MANAGEMENT_MASTER_KEY=replace-with-a-fourth-distinct-32-plus-character-random-secret
