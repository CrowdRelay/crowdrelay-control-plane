# Canonical shape of the managed control.virya.music site block served by the
# public edge (container virya-edge-caddy, compose project `edge` under
# /opt/crowdrelay/ops/edge on virya-crowdrelay). The edge is NOT deployed by
# scripts/deploy*.sh — they only manage the app and area tunnel. Sync this
# block to the live Caddyfile by hand and keep the two identical; the gates in
# scripts/static-check.py and scripts/check-web-source.mjs pin its contract.
#
# Host-state prerequisites and the credential rotation runbook live in
# docs/EDGE-OPERATIONS.md.
control.virya.music {
    encode zstd gzip

    # Fingerprinted bundles and static brand assets can be cached immutably.
    @immutable path /assets/* /crowdrelay-brand-mark.png /favicon.ico
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    log {
        output stdout
        format console
    }

    # The explicit `route` keeps the written order of the handlers below.
    # Machine telemetry writes keep their dedicated Bearer credentials end
    # to end and bypass browser Basic Auth entirely.
    route {
        # Operator session endpoints are public transport: the backend owns
        # credential verification, cookie issuance and revocation.
        @auth path /api/v1/auth/*
        handle @auth {
            reverse_proxy control-plane:8090 {
                health_uri /healthz/ready
                health_interval 15s
                health_timeout 3s
            }
        }

        # Cookie-bearing requests skip edge Basic auth and pass through
        # untouched — the backend validates the HttpOnly operator session
        # itself and fails closed. Anonymous requests with a forged cookie get
        # a backend 401, never plane access.
        @session_request header Cookie *crowdrelay_cp_session=*
        handle @session_request {
            reverse_proxy control-plane:8090 {
                health_uri /healthz/ready
                health_interval 15s
                health_timeout 3s
                transport http {
                    dial_timeout 2s
                    response_header_timeout 10s
                    keepalive 60s
                }
            }
        }

        @runtime_put {
            method PUT
            path /api/v1/tenants/*/runtime
        }
        handle @runtime_put {
            reverse_proxy control-plane:8090 {
                health_uri /healthz/ready
                health_interval 15s
                health_timeout 3s
            }
        }

        @provisioner path /api/v1/provisioner/*
        handle @provisioner {
            reverse_proxy control-plane:8090 {
                health_uri /healthz/ready
                health_interval 15s
                health_timeout 3s
            }
        }

        # The SPA shell stays public so the styled login renders without a
        # browser-native credential dialog. Every other /api/v1/* call is gated
        # here; the runtime READ is admin-authoritative backend-side, so it is
        # gated by method instead of being exempted outright. Both secrets are
        # resolved from files inside Caddy's config volume: content is read
        # per request (rotation needs no reload), but the files must exist
        # when Caddy provisions or it refuses to start — fail closed either
        # way, and kept out of `docker inspect`.
        @api {
            path /api/v1/*
            not path /api/v1/tenants/*/runtime
        }
        basic_auth @api {
            operator {file./config/control-plane-basic.bcrypt}
        }

        @runtime_read {
            method GET
            path /api/v1/tenants/*/runtime
        }
        basic_auth @runtime_read {
            operator {file./config/control-plane-basic.bcrypt}
        }

        # Single authority substitution: after the edge gate accepts
        # credentials, the backend validates every request independently
        # against the platform admin token, injected from host state rather
        # than the environment, where `docker inspect` would expose it.
        # "oracle-caddy" is an inherited observability marker kept identical
        # to the live edge on purpose.
        reverse_proxy control-plane:8090 {
            health_uri /healthz/ready
            health_interval 15s
            health_timeout 3s
            lb_try_duration 3s
            header_up Authorization "Bearer {file./config/control-plane-admin-token}"
            header_up X-Control-Plane-Edge "oracle-caddy"
            transport http {
                dial_timeout 2s
                response_header_timeout 10s
                keepalive 60s
            }
        }
    }

    # basic_auth emits its WWW-Authenticate challenge onto the shared response
    # writer before returning the 401 error; browsers answer that header with
    # the native credential dialog beside the styled login form. Deferred
    # deletions never see the challenge, so handle_errors rewrites the 401
    # without it: same status and empty body, no native credential dialog.
    handle_errors {
        @unauthorized expression {err.status_code} == 401
        route {
            header @unauthorized -WWW-Authenticate
            respond @unauthorized "" 401
        }
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }

    # The live edge wraps these in a shared (security_headers) snippet whose
    # CSP is limited to frame-ancestors; a standalone install gets the fuller
    # policy below. Tightening the shared snippet to match is tracked in
    # docs/EDGE-OPERATIONS.md.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    }
}
