control.virya.music {
    encode zstd gzip

    # Fingerprinted bundles and static brand assets can be cached immutably.
    @immutable path /assets/* /crowdrelay-brand-mark.png /favicon.ico
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    # Machine-only channels keep their dedicated Bearer credentials and bypass
    # browser Basic Auth entirely.
    @runtime path /api/v1/tenants/*/runtime
    handle @runtime {
        reverse_proxy 127.0.0.1:8090
    }

    @provisioner path /api/v1/provisioner/*
    handle @provisioner {
        reverse_proxy 127.0.0.1:8090
    }

    # Single auth gate: the app's own styled login form issues a tab-scoped
    # session token; the backend validates every API request independently.
    # No edge Basic Auth — the browser-native credential dialog was worse
    # than the security it added (defense-in-depth against an already
    # authenticated backend).
    handle {
        reverse_proxy 127.0.0.1:8090 {
            header_up Authorization "Bearer {$CONTROL_PLANE_ADMIN_TOKEN}"
        }
    }

    header {
        -WWW-Authenticate
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    }
}
